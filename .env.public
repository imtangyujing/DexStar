APP_NAME=GRAB API
ENV=public
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=10080
AUTH_DISABLED=true

DATABASE_URL=postgresql+psycopg://grab:grab@postgres:5432/grab
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/v1/auth/wechat/callback
WECHAT_AUTH_BYPASS=false

STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=grab-audio-public
STORAGE_SECURE=false
DOWNLOAD_URL_TTL_SECONDS=3600
OBJECT_RETENTION_HOURS=24

RATE_LIMIT_PER_HOUR=20
TEMP_DIR=/tmp/grab
ENABLE_AI_ANALYSIS=true
ENABLE_AI_NAMING_FALLBACK=false
ENABLE_BPM_KEY_ANALYSIS=true
ANALYSIS_BPM_BACKEND=auto
ANALYSIS_KEY_BACKEND=auto
TEMPO_CNN_GRAPH_PATH=/opt/grab/models/deeptemp-k16-3.pb
KEYFINDER_CLI_BIN=keyfinder-cli
KEYFINDER_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
COPYRIGHT_ADVICE_TEXT=尊重音乐版权。本工具仅供个人学习使用，如涉及商业用途，请联系创作者授权。
