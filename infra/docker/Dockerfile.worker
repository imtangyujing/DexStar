FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl libsndfile1 build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
ARG ESSENTIA_TF_VERSION=2.1b6.dev1389
ARG TEMPO_CNN_MODEL_URL=https://essentia.upf.edu/models/tempo/tempocnn/deeptemp-k16-3.pb
ARG TEMPO_CNN_MODEL_PATH=/opt/grab/models/deeptemp-k16-3.pb
ARG MADMOM_VERSION=0.16.1
RUN mkdir -p "$(dirname "${TEMPO_CNN_MODEL_PATH}")" \
    && curl -fsSL "${TEMPO_CNN_MODEL_URL}" -o "${TEMPO_CNN_MODEL_PATH}" \
    && pip install --no-cache-dir "numpy<3" "scipy<2" \
    && pip install --no-cache-dir Cython \
    && pip install --no-cache-dir "madmom==${MADMOM_VERSION}" \
    && pip install --no-cache-dir --default-timeout=300 "essentia-tensorflow==${ESSENTIA_TF_VERSION}" \
    && pip install --no-cache-dir -e .
CMD ["celery", "-A", "apps.worker.celery_app:celery_app", "worker", "--loglevel=INFO", "--concurrency=2"]
